# Every text file is stored and checked out with LF, on every platform. Tests compare fixture bytes
# (canonical JSON, golden reports, signatures) byte for byte, and a CRLF checkout on Windows breaks them.
* text=auto eol=lf

# Binary files are never converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.pdf binary
*.wasm binary
*.woff binary
*.woff2 binary
*.ttf binary
*.zip binary
*.gz binary

# Determinism samples and their expected reports are compared byte for byte (some deliberately contain
# CRLF, bare CR and a BOM); git must never normalise them.
tests/determinism/samples/* -text
tests/determinism/expected/* -text

# Demo test fixtures include invalid UTF-8, a BOM and CRLF on purpose; git must never normalise them.
tests/demo/fixtures/* -text

# Sprint 7: the release tool is vendored from AirplaneMode-Labs/runtime spec/tools byte for byte (spec release 0.6.1), together with the shared release vectors
# and the pin that records their digests. Release manifests and SHA256SUMS are hashed and signed, so git must never convert these (core.autocrlf=true on a
# Windows checkout would change the sha256 that scripts/release/VENDORED.json pins).
scripts/release/release-tool.mjs -text
scripts/release/vectors/** -text
scripts/release/VENDORED.json -text
